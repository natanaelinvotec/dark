# Copie para .env e preencha. O .env nunca vai para o Git.

# Pasta raiz no Google Drive sincronizado (cada canal tem uma subpasta)
ESTUDIO_DADOS=G:/Meu Drive/Estudio
# Banco SQLite (fica fora do Drive para não sincronizar no meio de uma escrita)
ESTUDIO_DB=./dados/estudio.db

# Painel: gere o hash com `uv run estudio senha`
ESTUDIO_SENHA_HASH=
# Segredo da sessão: no mínimo 32 caracteres aleatórios
# (ex.: python -c "import secrets; print(secrets.token_urlsafe(48))")
ESTUDIO_SEGREDO_SESSAO=
# 1 quando o painel for aberto por https (Cloudflare ou tailscale serve): uv run estudio configurar --online
ESTUDIO_COOKIE_SEGURO=0
# Endereço online do painel, se houver (o iniciar.bat abre este em vez do 127.0.0.1)
ESTUDIO_ENDERECO=

# Painel online no GitHub Pages (Firebase + Google Drive). Arquivos ficam em dados/ (fora do Git).
DONO_EMAIL=
FIREBASE_CREDENCIAIS=dados/firebase-servico.json
GOOGLE_OAUTH_CLIENTE=dados/google-oauth.json
GOOGLE_TOKEN=dados/google-token.json

# Gemini API (AI Studio) — cobrada à parte da assinatura Google AI Pro
GEMINI_API_KEY=
# Confira o nome do modelo vigente no AI Studio antes de usar
GEMINI_MODELO=gemini-2.5-flash

# Azure Speech (voz neural pt-BR)
AZURE_TTS_CHAVE=
AZURE_TTS_REGIAO=brazilsouth
AZURE_TTS_VOZ=pt-BR-AntonioNeural

# Bancos de imagem/vídeo (licença comercial)
PEXELS_CHAVE=
PIXABAY_CHAVE=

# Limites
TETO_MES_BRL=150
CAMBIO_USD_BRL=5.20
